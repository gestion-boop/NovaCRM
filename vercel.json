{
  "buildCommand": "vite build",
  "git": {
    "deploymentEnabled": {
      "claude/finish-tasks-7f70wu": false,
      "claude/immosphera-novavisio-visibility-l0ecp3": false
    }
  },
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/kdrive/callback",
      "destination": "/api/settings/bootstrap"
    },
    {
      "source": "/api/google/connect",
      "destination": "/api/admin/drive/google-connect"
    },
    {
      "source": "/api/google/callback",
      "destination": "/api/admin/drive/google-callback"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 9 * * *"
    }
  ]
}
