{
  "buildCommand": "vite build",
  "ignoreCommand": "bash -c 'if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ] || [ \"$VERCEL_GIT_COMMIT_REF\" = \"test\" ]; then exit 1; else exit 0; fi'",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/kdrive/callback",
      "destination": "/api/settings/bootstrap"
    },
    {
      "source": "/api/google/connect",
      "destination": "/api/admin/drive/google-connect"
    },
    {
      "source": "/api/google/callback",
      "destination": "/api/admin/drive/google-callback"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 9 * * *"
    }
  ]
}
